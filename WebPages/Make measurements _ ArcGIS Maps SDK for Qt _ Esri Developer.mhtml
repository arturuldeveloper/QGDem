ottom: 27.1812%; position: relative; bottom: 0px; left: 0px; background-ima=
ge: url(&quot;data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAAFCAIAAAD=
KYVtkAAAACXBIWXMAABJ0AAASdAHeZh94AAABA0lEQVR42k1PXU/CQBDk74tfbz7w4JuRaFBjUQ=
yJRgwxVgvaD6XQYoyCLdIvatu7tne33oExTiab3c1MdqcCK1DGeAFgywlj/DVzwsCfuU4UhkARs=
JIuBf9REUZCk84hWTgAn4B0yPQ4mipPL3Jf694phjkuMheyZ8gNoAOazhO5zf7MHLEztcfqrdY/=
