rwards running show-snackbar, 250ms cubic-bezier(0.4, 0, 1, 1) 5s 1 normal =
forwards running hide-snackbar; }

@-webkit-keyframes show-snackbar {=20
  100% { opacity: 1; transform: translateY(0px); }
